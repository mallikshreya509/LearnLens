# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Any Gemini model that supports structured (JSON schema) output.
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to force offline mock mode (no API calls, heuristic output).
# Mock mode is also used automatically when no API key is set.
LEARNLENS_MOCK=0

# Only needed if the frontend runs on a different origin than the backend
# (for example `python -m http.server 5173` in frontend/). Comma separated.
# CORS_ORIGINS=http://localhost:5173,https://your-site.example

# YouTube links: preferred caption languages, comma separated (any other language is used if none match).
# YOUTUBE_LANGS=en
# auto (default): try captions, then let Gemini listen to the video. Or: captions | gemini.
# YOUTUBE_METHOD=auto
# Optional proxy for caption requests, if YouTube blocks your server's address (common on cloud hosting).
# YOUTUBE_PROXY_URL=http://user:pass@proxy.example:8080
